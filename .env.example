# Native gateway listener port.
GATEWAY_PORT=8443
LOG_LEVEL=info
BRNAVI_TLS_DIR=/home/victor/.ssh/brnavi-tls

# Shared by both backend instances. Generate secrets using:
# Спільні для обох інстансів. Згенерувати секрети:
# sh scripts/init-auth-env.sh
AUTH_ISSUER=brnavi
# Comma-separated Google OAuth client IDs (Web client ID used by the app); enables auth.loginWithGoogle
GOOGLE_CLIENT_IDS=
# AUTH_DB_PASSWORD, AUTH_DB_ROOT_PASSWORD, BRNAVI_BROKER_PASSWORD,
# GATEWAY_SRT_PASSPHRASE and PASETO_LOCAL_KEY are generated in the ignored .env.
# AUTH_DB_PASSWORD, AUTH_DB_ROOT_PASSWORD, BRNAVI_BROKER_PASSWORD,
# GATEWAY_SRT_PASSPHRASE та PASETO_LOCAL_KEY створюються у .env, виключеному з Git.

# Password-reset e-mail (set SMTP_PASSWORD only in the ignored .env).
# Лист відновлення пароля (SMTP_PASSWORD задавайте лише в .env, виключеному з Git).
# SMTP_HOST=smtpout.secureserver.net
# SMTP_PORT=587
# SMTP_USERNAME=admin@mobilespace.biz
# SMTP_FROM=XRNavi <admin@mobilespace.biz>
# RESET_TOKEN_PUSH=0

# CarAPI plugin credentials. Set real values only in the ignored .env or
# /etc/brnavi/backend.env; never commit them.
# Облікові дані плагіна CarAPI. Справжні значення задавайте лише у .env
# (виключеному з Git) або /etc/brnavi/backend.env; не додавайте їх до комітів.
CARAPI_TOKEN=
CARAPI_SECRET=
