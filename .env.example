# brnavi (оркестратор) — власні налаштування TMS_* + спільний fallback для сервісів.
# Налаштування сервісів живуть у їхніх крейтах:
#   quic-jsonrpc-server/.env  (QUIC_RPC_* — QUIC/сесії/Mongo/TLS, HTTP_RPC_* — upstream HTTP driver-API)
# Пріоритет для КОЖНОЇ змінної: змінна процесу → .env крейту → цей кореневий .env.
# Якщо параметра немає у .env крейту або він порожній (KEY=), значення береться звідси.
# Відносні шляхи, задані тут, рахуються від кореня воркспейсу.
# Скопіюйте як .env у корені воркспейсу (необов'язково).

# TMS_SERVICES: які сервіси запускати. Allowed: all | rpc.
TMS_SERVICES=all
# TMS_RUST_LOG: явний фільтр логів для всього процесу; якщо не задано — збирається з
# QUIC_RPC_RUST_LOG сервісу.
# TMS_RUST_LOG=info,quic_jsonrpc_server=debug
