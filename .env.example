# Gateway is published only on this host address by default.
# Set to a trusted LAN address to connect a physical device on that LAN.
GATEWAY_PUBLISH_ADDRESS=127.0.0.1
GATEWAY_PORT=8443
LOG_LEVEL=info

# Shared by both backend instances. Generate secrets using:
# Спільні для обох інстансів. Згенерувати секрети:
# sh docker/init-auth-env.sh
AUTH_ISSUER=brnavi
# AUTH_DB_PASSWORD, AUTH_DB_ROOT_PASSWORD and PASETO_LOCAL_KEY are generated in the ignored .env.
# AUTH_DB_PASSWORD, AUTH_DB_ROOT_PASSWORD та PASETO_LOCAL_KEY створюються у виключеному з Git .env.

# Password-reset e-mail (set SMTP_PASSWORD only in the ignored .env).
# Лист відновлення пароля (SMTP_PASSWORD задавайте лише в .env, виключеному з Git).
# SMTP_HOST=smtpout.secureserver.net
# SMTP_PORT=587
# SMTP_USERNAME=admin@mobilespace.biz
# SMTP_FROM=XRNavi <admin@mobilespace.biz>
# RESET_TOKEN_PUSH=0
