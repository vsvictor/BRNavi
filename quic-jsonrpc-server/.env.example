# quic-jsonrpc-server — усі налаштування цього сервісу.
# Скопіюйте як quic-jsonrpc-server/.env — підхоплюється автоматично з будь-якого cwd
# (quic-jsonrpc-server/.env → quic-jsonrpc-server.env поруч із бінарником).
# Пріоритет: змінна процесу → цей файл → кореневий .env (fallback для відсутніх/порожніх параметрів).
# Відносні шляхи (certs) рахуються від директорії файлу, в якому задані.

# ---- QUIC listener ----
# QUIC_RPC_BIND: server bind address in <host>:<port> format.
# Allowed: valid socket address, e.g. 127.0.0.1:5000, 0.0.0.0:5000, [::1]:5000.
QUIC_RPC_BIND=0.0.0.0:5000
# QUIC_RPC_METRICS_INTERVAL_SECS: metrics log interval in seconds.
# Allowed: integer >= 1.
QUIC_RPC_METRICS_INTERVAL_SECS=10
# QUIC_RPC_KEEP_ALIVE_SECS: QUIC keep-alive packet interval in seconds.
# Allowed: integer >= 1.
QUIC_RPC_KEEP_ALIVE_SECS=10
# QUIC_RPC_IDLE_TIMEOUT_SECS: QUIC max_idle_timeout in seconds = dead-peer detection.
# Closes a connection when NOTHING has been received from the peer for this long — not even
# ACKs to our keep-alive PINGs. A live client (both sides PING every KEEP_ALIVE_SECS) never
# hits it regardless of application silence; a vanished phone (NAT drop, Doze, network switch
# without CONNECTION_CLOSE) is reaped instead of staying half-open. Session stays resumable
# for SESSION_TTL_SECS. Must be >= 3 x QUIC_RPC_KEEP_ALIVE_SECS.
# Allowed: integer >= 5.
QUIC_RPC_IDLE_TIMEOUT_SECS=60

# ---- Sessions ----
# QUIC_RPC_SESSION_TTL_SECS: session lifetime for login/resume in seconds.
# Allowed: integer >= 1.
QUIC_RPC_SESSION_TTL_SECS=86400
# QUIC_RPC_SESSION_CLEANUP_INTERVAL_SECS: expired session cleanup interval in seconds.
# Allowed: integer >= 1.
QUIC_RPC_SESSION_CLEANUP_INTERVAL_SECS=60
# QUIC_RPC_SESSION_BACKEND: storage backend for sessions.
# Allowed: mongo | memory.
QUIC_RPC_SESSION_BACKEND=mongo
# QUIC_RPC_ENABLE_SESSION_DEBUG: enables rpc.session.debug method.
# Allowed: true | false | 1 | 0 | yes | no | on | off (case-insensitive).
QUIC_RPC_ENABLE_SESSION_DEBUG=false

# ---- Abuse protection ----
# QUIC_RPC_AUTH_RATE_PER_MINUTE / QUIC_RPC_AUTH_RATE_BURST: per-client-IP token bucket for
# login / rpc.login / rpc.resume (credential-bearing methods). Other methods are not limited.
# Allowed: integers >= 0; PER_MINUTE=0 disables the limiter. Exceeding it yields error -32004.
QUIC_RPC_AUTH_RATE_PER_MINUTE=20
QUIC_RPC_AUTH_RATE_BURST=10

# ---- Upstream driver API (1C) over HTTP — HTTP_RPC_* ----
# HTTP_RPC_BASE_URL: upstream base URL for login/shift proxy (legacy alias: BASE_URL).
# Allowed: valid absolute HTTP/HTTPS URL without the /auth/login/ suffix.
HTTP_RPC_BASE_URL=http://192.168.0.22/tms/hs/driver-api
# HTTP_RPC_LOGIN_URL: optional full login URL override; default is <BASE_URL>/auth/login/.
# HTTP_RPC_LOGIN_URL=
# HTTP_RPC_LOGIN_TIMEOUT_MS: per-attempt HTTP timeout for upstream calls.
# Allowed: integer >= 1 (milliseconds).
HTTP_RPC_LOGIN_TIMEOUT_MS=5000
# HTTP_RPC_LOGIN_RETRIES: additional retry attempts after the first request.
# Allowed: integer >= 0.
HTTP_RPC_LOGIN_RETRIES=2
# HTTP_RPC_LOGIN_RETRY_BACKOFF_MS: delay between retries.
# Allowed: integer >= 1 (milliseconds).
HTTP_RPC_LOGIN_RETRY_BACKOFF_MS=300

# ---- Map tiles proxy (map.getTile) — MAP_TILE_* ----
# The server fetches raster tiles from the local OSM tile server (192.168.1.242:8000, plain HTTP),
# caches them in memory and returns them to the mobile client as base64 inside the JSON-RPC result.
# MAP_TILE_URL_TEMPLATE: upstream URL with {z} {x} {y} placeholders (all three required).
MAP_TILE_URL_TEMPLATE=http://192.168.1.242:8000/tiles/{z}/{x}/{y}.png
# MAP_TILE_USER_AGENT: identifying User-Agent sent to the tile server. If you ever point the
# template at tile.openstreetmap.org this is REQUIRED by the OSM tile usage policy.
MAP_TILE_USER_AGENT="ExpressT-TMS/1.0 (com.expresst.tms)"
# MAP_TILE_TIMEOUT_MS: per-attempt upstream timeout. Allowed: integer >= 1.
MAP_TILE_TIMEOUT_MS=10000
# MAP_TILE_RETRIES: extra attempts on transport failure / 5xx (GET is idempotent). Allowed: >= 0.
MAP_TILE_RETRIES=1
# MAP_TILE_RETRY_BACKOFF_MS: delay between retries. Allowed: integer >= 1.
MAP_TILE_RETRY_BACKOFF_MS=300
# MAP_TILE_MAX_ZOOM: highest zoom clients may request. Allowed: 0..22.
MAP_TILE_MAX_ZOOM=19
# MAP_TILE_MAX_BYTES: reject upstream tiles larger than this. Allowed: integer >= 1024.
MAP_TILE_MAX_BYTES=4194304
# MAP_TILE_CACHE_MAX_BYTES: in-memory LRU budget for tile bytes; 0 disables caching.
MAP_TILE_CACHE_MAX_BYTES=268435456
# MAP_TILE_CACHE_TTL_SECS: how long a cached tile stays valid. Allowed: integer >= 1.
MAP_TILE_CACHE_TTL_SECS=604800

# ---- MongoDB session storage ----
# QUIC_RPC_MONGO_URI: full connection string; when set, HOST/PORT/USER/PASSWORD/AUTH_SOURCE are ignored.
# QUIC_RPC_MONGO_URI=mongodb://user:pass@host:27017/?authSource=admin
# QUIC_RPC_MONGO_HOST: MongoDB host/IP.
QUIC_RPC_MONGO_HOST=192.168.1.132
# QUIC_RPC_MONGO_PORT: MongoDB TCP port (1..65535).
QUIC_RPC_MONGO_PORT=27017
# QUIC_RPC_MONGO_DB: logical database name used by the service.
QUIC_RPC_MONGO_DB=tms_db
# QUIC_RPC_MONGO_AUTH_SOURCE: auth DB where the Mongo user is defined (commonly admin or same as QUIC_RPC_MONGO_DB).
QUIC_RPC_MONGO_AUTH_SOURCE=tms_db
# QUIC_RPC_MONGO_USER / QUIC_RPC_MONGO_PASSWORD: REQUIRED unless QUIC_RPC_MONGO_URI is set (no built-in defaults).
QUIC_RPC_MONGO_USER=tms_admin
# QUIC_RPC_MONGO_PASSWORD: MongoDB password.
QUIC_RPC_MONGO_PASSWORD=change-me

# ---- TLS ----
# QUIC_RPC_CERT_PATH / QUIC_RPC_KEY_PATH: PEM certificate and private key for the server identity.
# Allowed: both set together and files must exist; if both are absent the server uses an ephemeral self-signed cert.
# Relative paths are resolved against quic-jsonrpc-server/ (certs live in the workspace root: ../certs).
# QUIC_RPC_CERT_PATH=../certs/server-cert.pem
# QUIC_RPC_KEY_PATH=../certs/server-key.pem

# ---- Logging ----
# QUIC_RPC_RUST_LOG: tracing filter for this service (falls back to RUST_LOG).
# Allowed: valid tracing filter string, e.g. info, debug, quic_jsonrpc_server=debug.
QUIC_RPC_RUST_LOG=info,quic_jsonrpc_server=debug
